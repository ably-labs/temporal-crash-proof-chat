# Copy to .env. `npm run setup:sandbox` creates an Ably sandbox app and writes ABLY_KEY and ABLY_ENDPOINT for you.

# An Ably API key. Only the workers and the demo server read it; the browser gets tokens from /api/auth.
ABLY_KEY=appId.keyId:keySecret

# Set to nonprod:sandbox for a sandbox key. Leave unset for a production key.
# ABLY_ENDPOINT=nonprod:sandbox

# The workers call the model through the Vercel AI SDK's Anthropic provider.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown).
# MODEL=claude-sonnet-5-5
# POOL_SIZE=3
# CHANNEL_PREFIX=mutable:chat-
# PORT=4300
# TEMPORAL_ADDRESS=localhost:7233
# TEMPORAL_NAMESPACE=default
# TEMPORAL_UI_URL=http://localhost:8233
# TASK_QUEUE=crash-proof-chat
