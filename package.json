{
  "name": "temporal-crash-proof-chat",
  "private": true,
  "type": "module",
  "description": "A chat agent that runs as a Temporal workflow and streams its reply over Ably with AI Transport and a realtime channel pool. Kill the worker mid-reply and the reply carries on from the other one.",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "setup:sandbox": "tsx src/setup-sandbox.ts",
    "typecheck": "tsc --noEmit",
    "start": "pnpm build:web && tsx src/main.ts",
    "verify": "tsx scripts/verify.ts",
    "build:web": "esbuild web/app.ts --bundle --format=esm --platform=browser --target=es2022 --sourcemap --outfile=public/app.js"
  },
  "dependencies": {
    "@ably/ai-transport": "1.0.0",
    "@ably/pubsub-core": "3.1.0",
    "@ably/pubsub-device": "3.1.0",
    "@ably/pubsub-server": "3.1.0",
    "@ai-sdk/anthropic": "4.0.90",
    "@temporalio/activity": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/common": "1.24.0",
    "@temporalio/plugin": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "ai": "7.0.155",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.0"
  }
}
